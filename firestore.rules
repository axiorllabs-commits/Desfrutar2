rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for RequestCounter entity
    function isValidRequestCounter(data) {
      return data.keys().hasAll(['lastNumber', 'updatedAt'])
        && data.keys().hasOnly(['lastNumber', 'updatedAt'])
        && data.lastNumber is int
        && data.lastNumber >= 1
        && data.lastNumber <= 1000000000
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Global sequential counter for WhatsApp availability requests (01, 02, 03...)
    match /counters/{counterId} {
      allow get: if isValidId(counterId) && counterId == 'solicitacoes';
      allow list: if false;
      allow delete: if false;

      allow create: if isValidId(counterId)
        && counterId == 'solicitacoes'
        && isValidRequestCounter(incoming())
        && incoming().lastNumber == 1;

      allow update: if isValidId(counterId)
        && counterId == 'solicitacoes'
        && isValidRequestCounter(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['lastNumber', 'updatedAt'])
          && incoming().lastNumber == existing().lastNumber + 1
        );
    }
  }
}
